{
  "name": "Kraken",
  "short_name": "Kraken",
  "description": "A free DAW with the real SLOOP and Clipper engines: arrange, play, mix and export full songs, offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#d6d7d4",
  "theme_color": "#0b0c0d",
  "categories": ["music", "entertainment", "productivity"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/kraken-icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".json"], "application/zip": [".zip"], "audio/midi": [".mid", ".midi"], "application/x-sloopsong": [".sloopsong"] } }
  ]
}
