# Kraken: settings for Apache (OVH, o2switch, Hostinger, cPanel and most shared hosting)
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
<IfModule mod_headers.c>
  # the app updates itself: these three must never be served stale
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(wasm|js|svg|png|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/javascript application/javascript application/json application/wasm image/svg+xml application/manifest+json
</IfModule>
# HTTPS is required (audio engine, installation): uncomment if your host does not redirect by itself
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
