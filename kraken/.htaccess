# Kraken: settings for Apache (OVH, o2switch, Hostinger, cPanel and most shared hosting)
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
<IfModule mod_headers.c>
  # several cores for the audio (multi-core playback): the page isolated from other sites' windows
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Embedder-Policy "credentialless"
  # the app's files: asked again each time (a quick "not changed" answer when they are the same), so a page never
  # mixes an old file with a new one after an update (the service worker keeps them offline)
  <FilesMatch "\.(wasm|js|mjs|css|svg|png|json|webp)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # the app updates itself: these three must never be served stale (after the rule above, so it wins for sw.js)
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|hub\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/javascript application/javascript application/json application/wasm image/svg+xml application/manifest+json
</IfModule>
# the community hub (api/, PHP): no folder listings; api/.htaccess guards its own files
Options -Indexes
DirectoryIndex index.html index.php
# HTTPS is required (audio engine, installation): uncomment if your host does not redirect by itself
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# added by PUBLIER-KRAKEN.bat: last, so it wins over the .js rule above (sw.js must never be cached)
<IfModule mod_headers.c>
  <FilesMatch ^(index\.html|sw\.js|manifest\.webmanifest)$>
    Header set Cache-Control no-cache
  </FilesMatch>
</IfModule>
